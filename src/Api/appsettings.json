{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=ecommerce.db"
  },
  "Jwt": {
    "Issuer": "ecommerce-clean-arch",
    "Audience": "ecommerce-clean-arch-clients",
    "SigningKey": "dev-only-signing-key-change-me-32-chars-min",
    "ExpiryMinutes": 60
  }
}
